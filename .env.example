# LLM providers. Both optional: without keys the app runs in degraded mode
# (template explanations, rule-based question answering).
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GEMINI_MODEL=gemini-3.8-flash
LEADLENS_DB_PATH=backend/data/leadlens.duckdb
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
