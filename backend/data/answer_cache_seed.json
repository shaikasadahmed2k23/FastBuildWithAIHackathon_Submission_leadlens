  "payload": {
   "question": "How many stale leads does each owner have?",
   "answer": "Daniel Ortiz has 69 stale leads, Lucas Martin has 58, Aisha Bello has 65, Maya Chen has 66, Tom Becker has 59, Hana Sato has 59, Priya Nair has 53, and Ravi Kumar has 51 stale leads.",
   "sql": "WITH stale_leads AS (SELECT owner FROM leads WHERE stage NOT IN ('won','lost') AND ( (last_contacted_at IS NOT NULL AND last_contacted_at < TIMESTAMP '2026-09-15 12:00:00' - INTERVAL 90 DAY) OR (last_contacted_at IS NULL AND created_at < TIMESTAMP '2026-09-15 12:00:00' - INTERVAL 90 DAY) ) ) SELECT owner, COUNT(*) AS stale_lead_count FROM stale_leads GROUP BY owner",
