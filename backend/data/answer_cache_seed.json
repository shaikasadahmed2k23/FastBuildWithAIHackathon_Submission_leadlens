  "payload": {
   "question": "Average lead score by industry",
   "answer": "The average lead scores are: Fintech 44.03, Healthcare 41.14, Education 36.38, Logistics 37.97, Manufacturing 37.26, E-commerce 40.61, Media 36.96, and Software 43.02.",
   "sql": "WITH ls AS (SELECT l.lead_id, ls.score FROM leads l JOIN lead_scores ls ON l.lead_id = ls.lead_id) SELECT c.industry, AVG(ls.score) AS avg_score FROM leads l JOIN companies c ON l.company_id = c.company_id JOIN lead_scores ls ON l.lead_id = ls.lead_id GROUP BY c.industry",
