 {
  "kind": "ask",
  "key": "691b7f440e5021b4",
  "payload": {
   "question": "Top 10 open leads in Fintech",
   "answer": "The top 10 open fintech leads are Samuel Garcia (LD-00911), Donna Carroll (LD-04302), Matthew Elliott (LD-01359), Melissa Stephens (LD-03047), Cassidy Brady (LD-04836), Kimberly Navarro (LD-00968), Kevin Moses (LD-01056), Tina Horton (LD-02091), Joshua Melton (LD-01467), and Eric Black (LD-03832).",
   "sql": "WITH filtered AS (SELECT l.lead_id, l.first_name || ' ' || l.last_name AS name, ls.score FROM leads l JOIN companies c ON l.company_id = c.company_id JOIN lead_scores ls ON l.lead_id = ls.lead_id WHERE l.stage NOT IN ('won','lost') AND c.industry = 'Fintech') SELECT lead_id, name FROM filtered ORDER BY score DESC, lead_id LIMIT 10",
   "columns": [
    "lead_id",
    "name"
   ],
   "rows": [
    {
     "lead_id": "LD-00911",
     "name": "Samuel Garcia"
    },
